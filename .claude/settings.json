{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(npx prettier --write:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.dev.vars)",
      "Read(./**/.dev.vars.*)",
      "Bash(cat:*.env)",
      "Bash(npx wrangler secret:*)",
      "Bash(git push --force:*)"
    ]
  }
}
